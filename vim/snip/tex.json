{
  "section": {
    "prefix": ["sec"],
    "body": [
      "%%%%%%%%%%%%%%%%%%%%%%%%%%%%",
      "%% $1",
      "%%%%%%%%%%%%%%%%%%%%%%%%%%%%",
      "\\section{$1} \\label{sec:$2}",
      "$0"
    ],
    "description": "create section"
  },

  "subsection": {
    "prefix": ["ssec"],
    "body": [
      "%%%%%%%%%%%%%%%%%%%%%%%%%%%%",
      "\\subsection{$1} \\label{ssec:$2}",
      "$0"
    ],
    "description": "create subsection"
  },

  "subsubsection": {
    "prefix": ["sssec"],
    "body": [
      "%%%%%%%%%%%%%%%%%%%%%%%%%%%%",
      "\\subsubsection{$1} \\label{sssec:$2}",
      "$0"
    ],
    "description": "create subsubsection"
  },

  "table": {
    "prefix": ["tab"],
    "body": [
      "\\begin{table}[tb]",
      "\t\\begin{center}",
      "\t\t\\caption{$1}\\label{tab:$2}",
      "\t\t\\begin{tabular}{$3}",
      "\t\t\t\\hline\\hline",
      "\t\t\t$0",
      "\t\t\t\\hline",
      "\t\t\t\\hline",
      "\t\t\t\\end{tabular}",
      "\t\\end{center}",
      "\\end{table}"
    ],
    "description": "create table"
  },

  "tab-line": {
    "prefix": ["tab-line"],
    "body": [
      "\\begin{table}[tb]",
      "\t\\begin{center}",
      "\t\t\\caption{$1}\\label{tab:$2}",
      "\t\t\\begin{tabular}{$3}",
      "\t\t\t\\toprule",
      "\t\t\t$0",
      "\t\t\t\\midrule",
      "\t\t\t\\bottomrule",
      "\t\t\t\\end{tabular}",
      "\t\\end{center}",
      "\\end{table}"
    ],
    "description": "create table"
  },

  "figure": {
    "prefix": ["fig"],
    "body": [
      "\\begin{figure}[tb]",
      "\t\\begin{center}",
      "\t\t\\includegraphics[clip,width=0.95\\columnwidth]{figs/$1.pdf}",
      "\t\\end{center}",
      "\t\\caption{$2}\\label{fig:$3}",
      "\\end{figure}"
    ],
    "description": "create figure"
  },

  "insertfigure": {
    "prefix": ["insert"],
    "body": [
      "\\insertfigure[${1:size}]{fig:${2:label}}{${3:filename}}{${4:jp_caption}}{${5:en_caption}}"
    ],
    "description": "create inserfigure"
  },

  "enumerate": {
    "prefix": ["enumerate"],
    "body": [
      "\\begin{enumerate}",
      "\t\\item $1",
      "\\end{enumerate}"
    ],
    "description": "insert enumerate environment"
  },

  "itemize": {
    "prefix": ["itemize"],
    "body": [
      "\\begin{itemize}",
      "\t\\item $1",
      "\\end{itemize}"
    ],
    "description": "insert itemize environment"
  },

  "description": {
    "prefix": ["description"],
    "body": [
      "\\begin{description}",
      "\t\\item[$1] $2",
      "\\end{description}"
    ],
    "description": "insert description environment"
  },

  "item": {
    "prefix": ["it"],
    "body": [
      "\\item $1"
    ],
    "description": "item"
  },

  "verb": {
    "prefix": ["ve"],
    "body": [
      "\\verb|$1|"
    ],
    "description": "Insert single line verbatim"
  },

  "listing": {
    "prefix": ["list"],
    "body": [
      "\\begin{lstlisting}",
      "$1",
      "\\end{lstlisting}"
    ],
    "description": "Insert listing environment"
  }
}
